{
  "name": "jikklo-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrations:list:local": "wrangler d1 migrations list jikklo-db --local",
    "migrations:list:remote": "wrangler d1 migrations list jikklo-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply jikklo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jikklo-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.133.0"
  }
}
