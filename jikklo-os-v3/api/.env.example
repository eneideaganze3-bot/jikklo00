# =====================================================================
# JIKKLO API — Variables d'environnement
# =====================================================================
# NE JAMAIS remplir ce fichier avec de vraies valeurs et le committer.
# En local : copier en `.dev.vars` (lu automatiquement par `wrangler dev`).
# En production : utiliser `wrangler secret put <NOM>` pour chaque secret.
# =====================================================================

# Secret utilisé pour signer les tokens de connexion (JWT).
# Générer une valeur aléatoire longue, par ex. avec :
#   openssl rand -base64 48
JWT_SECRET=

# WhatsApp Business Cloud API (optionnel — le système fonctionne sans,
# il indique juste que WhatsApp n'est pas configuré).
# Obtenus depuis https://developers.facebook.com/apps (WhatsApp product)
# Voir docs/WHATSAPP_SETUP.md pour le détail de chaque valeur.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Réservé pour un usage futur (templates de message Meta) — non encore
# consommé par le code actuel, qui n'utilise que les deux valeurs ci-dessus.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# development | production
ENVIRONMENT=development
